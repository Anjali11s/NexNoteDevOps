pipeline {
    agent any
    
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
    }
    
    stages {
        stage('Check Kubernetes') {
            steps {
                script {
                    sh 'kubectl get nodes'
                }
            }
        }
        
        stage('Deploy Backend') {
            steps {
                script {
                    sh """
                        kubectl set image deployment/backend \
                            backend=singhanjali1/nexnote-backend:${params.IMAGE_TAG} \
                            -n nexnote || true
                    """
                }
            }
        }
        
        stage('Deploy Frontend') {
            steps {
                script {
                    sh """
                        kubectl set image deployment/frontend \
                            frontend=singhanjali1/nexnote-frontend:${params.IMAGE_TAG} \
                            -n nexnote || true
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                script {
                    sh """
                        kubectl rollout status deployment/backend -n nexnote --timeout=3m || true
                        kubectl rollout status deployment/frontend -n nexnote --timeout=3m || true
                    """
                }
            }
        }
        
        stage('Show Status') {
            steps {
                script {
                    sh """
                        kubectl get pods -n nexnote
                        kubectl get services -n nexnote
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo '✅ Deployment successful!'
        }
        failure {
            echo '❌ Deployment failed!'
        }
    }
}