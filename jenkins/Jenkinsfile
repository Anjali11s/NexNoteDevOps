pipeline {
    agent any
    
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
    }
    
    stages {
        stage('Deployment Info') {
            steps {
                echo "========================================="
                echo "🚀 NEXNOTE DEPLOYMENT TRIGGERED"
                echo "========================================="
                echo "Build Number: ${env.BUILD_NUMBER}"
                echo "Image Tag: ${params.IMAGE_TAG}"
                echo "Backend Image: singhanjali1/nexnote-backend:${params.IMAGE_TAG}"
                echo "Frontend Image: singhanjali1/nexnote-frontend:${params.IMAGE_TAG}"
                echo "Triggered by: GitHub Actions"
                echo "========================================="
                echo "✅ DEPLOYMENT INFORMATION LOGGED"
                echo "========================================="
            }
        }
        
        stage('Actual Deployment (K8s)') {
            steps {
                echo "Note: kubectl commands will run on EC2 production"
                echo "For local demo, deployment info is sufficient"
                echo ""
                echo "To deploy on production EC2, run:"
                echo "kubectl set image deployment/backend backend=singhanjali1/nexnote-backend:${params.IMAGE_TAG} -n nexnote"
                echo "kubectl set image deployment/frontend frontend=singhanjali1/nexnote-frontend:${params.IMAGE_TAG} -n nexnote"
            }
        }
    }
    
    post {
        success {
            echo '✅ Jenkins pipeline successful!'
            echo "🎉 Deployment triggered for tag: ${params.IMAGE_TAG}"
        }
        failure {
            echo '❌ Jenkins pipeline failed!'
        }
    }
}